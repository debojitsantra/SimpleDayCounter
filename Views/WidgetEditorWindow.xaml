<Window x:Class="SimpleDayCounter.Views.WidgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget"
        Width="360" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock Text="Label" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox x:Name="LabelBox" Margin="0,0,0,12" />

        <TextBlock Text="Target date" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="DayBox" Width="70" Margin="0,0,6,0" />
            <ComboBox x:Name="MonthBox" Width="120" Margin="0,0,6,0" />
            <ComboBox x:Name="YearBox" Width="90" />
        </StackPanel>

        <TextBlock Text="Color" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="ColorBox" Margin="0,0,0,4" />
        <TextBlock Text="Or type a custom hex color (e.g. #378ADD):" FontSize="11" Foreground="Gray" Margin="0,0,0,2" />
        <TextBox x:Name="CustomColorBox" Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="90" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
