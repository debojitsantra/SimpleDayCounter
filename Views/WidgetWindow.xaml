<Window x:Class="SimpleDayCounter.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day Counter Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#55000000"
            CornerRadius="14"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="22,18">
        <StackPanel MinWidth="160" HorizontalAlignment="Center">
            <TextBlock x:Name="DaysText"
                       Text="0"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#7F77DD"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock x:Name="DaysLabelText"
                       Text="DAYS LEFT"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#CCFFFFFF"
                       Opacity="0.8"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="TitleText"
                       Text="Event name"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="220" />
            <TextBlock x:Name="DateText"
                       Text="January 1, 2027"
                       FontSize="11"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</Window>
