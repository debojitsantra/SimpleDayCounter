<Window x:Class="SimpleDayCounter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleDayCounter.Views"
        Title="SimpleDayCounter - Settings"
        Width="460" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <local:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Your widgets"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <ListBox x:Name="WidgetsList"
                 Grid.Row="1"
                 SelectionMode="Single"
                 MouseDoubleClick="WidgetsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <Border Width="10" Height="10" CornerRadius="5"
                                Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="Bold" />
                            <TextBlock Text="{Binding TargetDate, StringFormat='{}{0:MMMM d, yyyy}'}"
                                       FontSize="11" Foreground="Gray" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add widget" Width="100" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="EditButton" Content="Edit" Width="80" Margin="0,0,8,0" Click="EditButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button x:Name="CloseButton" Content="Close" Width="80" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
